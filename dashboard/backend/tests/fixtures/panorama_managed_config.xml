<?xml version="1.0"?>
<config version="11.1.0" urldb="paloaltonetworks">
  <mgt-config>
    <users>
      <entry name="admin">
        <phash>$1$abcdefgh$somehash</phash>
        <permissions><role-based><superuser>yes</superuser></role-based></permissions>
      </entry>
    </users>
  </mgt-config>
  <devices>
    <entry name="localhost.localdomain">
      <deviceconfig>
        <system>
          <hostname>panorama-managed-fw</hostname>
          <panorama>
            <local-panorama/>
          </panorama>
        </system>
      </deviceconfig>
      <vsys>
        <entry name="vsys1">
          <zone/>
          <rulebase>
            <security>
              <rules/>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>

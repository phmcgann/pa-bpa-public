<?xml version="1.0"?>
<config version="10.2.0" urldb="paloaltonetworks">
  <mgt-config>
    <users>
      <entry name="admin">
        <phash>$1$abcdefgh$somehash</phash>
        <permissions><role-based><superuser>yes</superuser></role-based></permissions>
      </entry>
      <entry name="jsmith">
        <phash>$1$abcdefgh$anotherhash</phash>
        <authentication-profile>corp-radius</authentication-profile>
        <permissions><role-based><superuser>yes</superuser></role-based></permissions>
      </entry>
      <entry name="saved-log-query-1">
        <query>(zone.src eq trust)</query>
      </entry>
    </users>
  </mgt-config>
  <shared>
    <log-settings>
      <syslog>
        <entry name="siem-logs">
          <server>
            <entry name="siem-logs">
              <server>10.0.0.50</server>
              <port>514</port>
              <transport>UDP</transport>
              <format>BSD</format>
            </entry>
          </server>
        </entry>
      </syslog>
    </log-settings>
  </shared>
  <devices>
    <entry name="localhost.localdomain">
      <deviceconfig>
        <system>
          <hostname>fw01</hostname>
          <ntp-servers>
            <primary-ntp-server>
              <ntp-server-address>0.pool.ntp.org</ntp-server-address>
            </primary-ntp-server>
            <secondary-ntp-server>
              <server>1.pool.ntp.org</server>
            </secondary-ntp-server>
          </ntp-servers>
        </system>
      </deviceconfig>
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="trust">
              <network><layer3/></network>
            </entry>
            <entry name="untrust">
              <network>
                <layer3/>
                <zone-protection-profile>strict-zpp</zone-protection-profile>
              </network>
            </entry>
          </zone>
          <rulebase>
            <security>
              <rules>
                <entry name="allow-any-any-any">
                  <from><member>any</member></from>
                  <to><member>any</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="web-servers-inbound">
                  <from><member>untrust</member></from>
                  <to><member>dmz</member></to>
                  <source><member>any</member></source>
                  <destination><member>10.0.0.5</member></destination>
                  <application><member>ssl</member><member>web-browsing</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                  <description>Public web servers</description>
                  <profile-setting><group><member>strict-profiles</member></group></profile-setting>
                </entry>
                <entry name="temp-debug-rule">
                  <from><member>trust</member></from>
                  <to><member>trust</member></to>
                  <source><member>10.1.1.0/24</member></source>
                  <destination><member>10.1.2.0/24</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                  <log-end>no</log-end>
                  <log-start>no</log-start>
                </entry>
                <entry name="ftp-legacy-transfer">
                  <from><member>trust</member></from>
                  <to><member>dmz</member></to>
                  <source><member>10.1.3.10</member></source>
                  <destination><member>10.0.0.9</member></destination>
                  <application><member>ftp</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                  <description>Legacy FTP transfer job</description>
                  <profile-setting><group><member>strict-profiles</member></group></profile-setting>
                </entry>
                <entry name="bgp-peering">
                  <from><member>trust</member></from>
                  <to><member>trust</member></to>
                  <source><member>10.9.9.1</member></source>
                  <destination><member>10.9.9.2</member></destination>
                  <application><member>bgp</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                  <description>BGP peering</description>
                </entry>
                <entry name="deny-suspicious">
                  <from><member>any</member></from>
                  <to><member>any</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>deny</action>
                  <log-end>no</log-end>
                  <disabled>yes</disabled>
                </entry>
              </rules>
            </security>
          </rulebase>
          <profiles>
            <virus>
              <entry name="default-av"/>
              <entry name="unused-av"/>
            </virus>
          </profiles>
          <!-- profile-group is a sibling of <profiles>, not nested inside it —
               matches the real PAN-OS schema (verified against an 11.1 export). -->
          <profile-group>
            <entry name="strict-profiles">
              <virus><member>default-av</member></virus>
            </entry>
          </profile-group>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>

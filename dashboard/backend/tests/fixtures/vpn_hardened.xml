<?xml version="1.0"?>
<!--
  Synthetic fixture: a site-to-site VPN set up the way every vpn_* / ike_* rule recommends
  (IKEv2, AES-GCM, DH group 20, PFS, tunnel monitor), plus a GlobalProtect satellite tunnel the
  checks must ignore. Tests weaken one setting at a time. Element names follow the pan-os-codegen
  specs: objects/profiles/{ike,ipsec}-crypto-profile, network/ike-gateway, network/tunnels/ipsec.
-->
<config version="11.1.0" urldb="paloaltonetworks">
  <devices>
    <entry name="localhost.localdomain">
      <network>
        <ike>
          <crypto-profiles>
            <ike-crypto-profiles>
              <entry name="strong-ike">
                <encryption><member>aes-256-gcm</member></encryption>
                <hash><member>non-auth</member></hash>
                <dh-group><member>group20</member></dh-group>
                <lifetime><hours>8</hours></lifetime>
              </entry>
            </ike-crypto-profiles>
            <ipsec-crypto-profiles>
              <entry name="strong-ipsec">
                <esp><encryption><member>aes-256-gcm</member></encryption><authentication><member>none</member></authentication></esp>
                <dh-group>group20</dh-group>
                <lifetime><hours>1</hours></lifetime>
              </entry>
            </ipsec-crypto-profiles>
          </crypto-profiles>
          <gateway>
            <entry name="dc-gw">
              <authentication><pre-shared-key><key>-AQ==</key></pre-shared-key></authentication>
              <protocol>
                <ikev1><exchange-mode>main</exchange-mode><ike-crypto-profile>strong-ike</ike-crypto-profile></ikev1>
                <ikev2><ike-crypto-profile>strong-ike</ike-crypto-profile><dpd><enable>yes</enable></dpd></ikev2>
                <version>ikev2</version>
              </protocol>
              <local-address><interface>ethernet1/1</interface></local-address>
              <peer-address><ip>198.51.100.20</ip></peer-address>
            </entry>
          </gateway>
        </ike>
        <tunnel>
          <ipsec>
            <entry name="dc-tun">
              <auto-key><ike-gateway><entry name="dc-gw"/></ike-gateway><ipsec-crypto-profile>strong-ipsec</ipsec-crypto-profile></auto-key>
              <tunnel-monitor><enable>yes</enable><destination-ip>10.20.0.1</destination-ip><tunnel-monitor-profile>default</tunnel-monitor-profile></tunnel-monitor>
              <tunnel-interface>tunnel.1</tunnel-interface>
            </entry>
            <entry name="gp-sat">
              <global-protect-satellite><portal-address>vpn.example.com</portal-address><local-address><interface>ethernet1/1</interface></local-address></global-protect-satellite>
              <tunnel-interface>tunnel.9</tunnel-interface>
            </entry>
          </ipsec>
        </tunnel>
      </network>
    </entry>
  </devices>
</config>

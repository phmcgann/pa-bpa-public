POSTGRES_USER=pabpa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pabpa

# Reverse proxy (Caddy). Leave SITE_ADDRESS as localhost for local testing (Caddy self-signs
# automatically); set it to your real domain when deploying somewhere reachable from the internet.
#
# The dashboard's sign-in page checks this username and bcrypt password hash. Create the hash with
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'Your-Password'
# BASIC_AUTH_HASH MUST be single-quoted — it's a bcrypt hash full of $ characters,
# and Docker Compose tries to interpolate unquoted/double-quoted $ in .env values.
# Optional: SESSION_HOURS (default 12) is how long a sign-in lasts.
SITE_ADDRESS=localhost
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='changeme'

# Optional: Palo Alto Strata Cloud Manager BPA. A service account (Identity & Access >
# Service Accounts) with the Network Administrator + Security Administrator roles, and
# your tenant service group (TSG) ID. Leave empty to hide the "Run Palo Alto SCM BPA" button.
SCM_CLIENT_ID=
SCM_CLIENT_SECRET=
SCM_TSG_ID=

# Optional: the backend downloads Palo Alto Networks' public security advisories
# (security.paloaltonetworks.com) twice a day to match them against each firewall's
# PAN-OS version. Set to off where the server can't reach the internet.
PAN_ADVISORY_FEED=on
